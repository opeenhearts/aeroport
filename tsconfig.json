{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["frontend/shared/*"],
      "@R/*": ["R/frontend/*"],
      "@S/*": ["S/frontend/*"],
      "@H/*": ["H/frontend/*"],
      "@W/*": ["W/frontend/*"]
    }
  },
  "include": ["frontend", "R/frontend", "S/frontend", "H/frontend", "W/frontend", "vite.config.ts"]
}
